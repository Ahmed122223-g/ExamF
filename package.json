{
  "name": "exam-platform-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && shx cp dist/index.html dist/404.html && shx cp dist/index.html dist/200.html",
    "preview": "vite preview",
    "predeploy": "cross-env VITE_GITHUB_PAGES=true vite build && shx cp dist/index.html dist/404.html && shx cp dist/index.html dist/200.html",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "html2pdf.js": "^0.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "shx": "^0.4.0",
    "vite": "^6.0.7"
  }
}
